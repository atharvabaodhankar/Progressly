# AWS Configuration for Bedrock AI Worker
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_EXTRACTION_MODEL_ID=us.amazon.nova-micro-v1:0

# Temporary Groq Provider Configuration (Awaiting Bedrock Quota Approval)
EXTRACTION_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_1,your_groq_api_key_2

# Database & Queuing
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/bridgeiq_db
NODE_ENV=development
