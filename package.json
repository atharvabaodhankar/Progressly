{
  "name": "bridgeiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "ai-worker",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev --workspace=ai-worker",
