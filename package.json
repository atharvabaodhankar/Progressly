{
  "name": "bridgeiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "ai-worker",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev --workspace=ai-worker",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces",
    "migrate": "tsx database/scripts/migrate.ts",
    "seed": "tsx database/scripts/seed.ts",
    "seed:matches": "npm run seed:matches --workspace=ai-worker",
    "seed:historical": "npm run seed:historical --workspace=ai-worker",
    "test:extract": "npm run test:extract --workspace=ai-worker",
    "embed:schedule": "npm run embed:schedule --workspace=ai-worker",
    "test:match": "npm run test:match --workspace=ai-worker",
    "test:retrieve": "npm run test:retrieve --workspace=ai-worker",
    "test:memory": "npm run test:memory --workspace=ai-worker",
    "audit:hardening": "npm run audit:hardening --workspace=ai-worker"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2"
  }
}
